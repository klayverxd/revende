{
	"name": "imprimimos",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-strip-types --import ./tests/alias-hook.mjs tests/unit/**/*.test.ts",
		"test:db": "node --test --experimental-strip-types --import ./tests/alias-hook.mjs tests/integration/**/*.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"db:types": "node scripts/gerar-tipos.mjs",
		"db:types:check": "node scripts/gerar-tipos.mjs --check",
		"test:all": "npm run typecheck && npm run lint && npm run test && npm run test:db",
		"verify": "npm run typecheck && npm run lint && npm run db:types:check && npm run test && npm run test:db && npm run build"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@supabase/ssr": "^0.10.2",
		"@supabase/supabase-js": "^2.105.1",
		"next": "^15.3.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.74.0",
		"react-markdown": "^10.1.0",
		"recharts": "^3.8.1",
		"remark-gfm": "^4.0.1",
		"zod": "^4.4.1"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/eslintrc": "^3.3.6",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "^15.3.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
